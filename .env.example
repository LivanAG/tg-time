# Configuración de PRODUCCIÓN (VM de Oracle Cloud). En LOCAL no hace falta .env: `docker compose up --build`
# usa valores de desarrollo.
#
# En la VM:  cp .env.example .env && chmod 600 .env   y rellena todo (docs/DEPLOY.md tiene un comando que
# genera los secretos). Nunca subas .env a git (está en .gitignore).
#
# Formato: VARIABLE=valor, sin comillas ni espacios alrededor del "=". Los comentarios van en su propia
# línea: Docker Compose tomaría un "# ..." escrito tras un valor como parte del valor.

# ---- Docker Compose ----
# Con esto, "docker compose ps/logs/..." en la VM usa siempre la configuración de producción (sin la
# override de desarrollo, que arrancaría el backend en perfil dev).
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Perfil de Spring y de los comandos make (make deploy/update/backup... exigen prod).
SPRING_PROFILE=prod

# ---- Dominio y HTTPS ----
# Nombre público con el que se abre la aplicación (sin https://). Define los orígenes permitidos.
#   Provisional, sin dominio: horas.158-179-220-119.sslip.io   (con CADDYFILE=Caddyfile)
#   Final, con Cloudflare:    horas.tudominio.com               (con CADDYFILE=Caddyfile.cloudflare)
DOMAIN=horas.158-179-220-119.sslip.io
# Configuración de Caddy (fichero dentro de deploy/):
#   Caddyfile             HTTPS automático con Let's Encrypt (sslip.io o dominio sin proxy de Cloudflare)
#   Caddyfile.cloudflare  dominio tras el proxy de Cloudflare con certificado de origen en deploy/certs/
#   Caddyfile.http        solo HTTP por IP, para comprobar que responde (el login no funciona así)
CADDYFILE=Caddyfile

# ---- Base de datos ----
# Solo se aplican la PRIMERA vez (al crear el volumen pgdata). Cambiarlas después no cambia la
# contraseña de PostgreSQL y el backend dejaría de conectar.
# Genera la contraseña con: openssl rand -hex 24
DB_NAME=control_horario
DB_USER=ch_app
DB_PASSWORD=cambia-esto

# ---- Seguridad ----
# Firma de los tokens de sesión. Genera el secreto con: openssl rand -base64 48
# (el backend no arranca en prod si falta, es corto o es un valor de ejemplo). Cambiarlo cierra todas
# las sesiones.
JWT_SECRET=cambia-esto

# ---- Administrador inicial ----
# Se crea al arrancar si no hay ningún usuario. Contraseña de 12 caracteres o más que no sea una
# contraseña común (si no, el backend no crea el usuario y lo indica en el log).
# Genera una con: openssl rand -base64 18
# Borra estas dos líneas después del primer arranque (make deploy) una vez que hayas entrado.
APP_ADMIN_EMAIL=tu@email.com
APP_ADMIN_PASSWORD=cambia-esto

# ---- JVM ----
# Heap fijo de 1,5 GB reservado al arrancar: mantiene la memoria usada de la VM por encima del 20 %
# (Oracle reclama las instancias Always Free inactivas). El contenedor tiene un límite de 2304 MB.
JAVA_OPTS=-Xms1500m -Xmx1500m -XX:+AlwaysPreTouch -XX:+ExitOnOutOfMemoryError

# ---- Copias de seguridad ----
# Contraseña de cifrado de las copias (GPG AES-256). Genera una con: openssl rand -base64 32
# GUÁRDALA FUERA DE LA VM (gestor de contraseñas): sin ella las copias no se pueden restaurar.
BACKUP_PASSPHRASE=cambia-esto
# Usuario y grupo de la VM dueños de backups/ (salida de "id -u" y "id -g"; en Oracle Ubuntu suele ser 1001).
HOST_UID=1001
HOST_GID=1001
