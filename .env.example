# Copia este fichero a .env (nunca se sube a git). En la VM: chmod 600 .env
# Los comentarios van en su propia línea: Docker Compose tomaría un "# ..." escrito tras un
# valor vacío como parte del valor.

# Perfil: dev (tu máquina, make dev) | prod (VM de Oracle Cloud, make deploy)
SPRING_PROFILE=dev

# Registro de imágenes, en minúsculas. El CI publica en ghcr.io/<usuario-github>.
REGISTRY=ghcr.io/livanag

# ---- Solo prod ----
# Dominio público. Sin dominio propio: horas.<IP-pública-con-guiones>.sslip.io
DOMAIN=horas.example.com
# Caddyfile = HTTPS directo con Let's Encrypt | Caddyfile.cloudflare = detrás de Cloudflare
CADDYFILE=Caddyfile
# Contraseña de cifrado de las copias. Genera una con: openssl rand -base64 32 (guárdala fuera de la VM)
BACKUP_PASSPHRASE=cambia-esto

# ---- Base de datos ----
# Genera la contraseña con: openssl rand -base64 24
DB_NAME=control_horario
DB_USER=ch_app
DB_PASSWORD=cambia-esto

# ---- Seguridad ----
# Genera el secreto con: openssl rand -base64 48 (mínimo 256 bits; en prod el backend no arranca sin él)
JWT_SECRET=cambia-esto
