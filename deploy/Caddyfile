# HTTPS automático con Let's Encrypt (CADDYFILE=Caddyfile en .env). DOMAIN viene de .env.
# Sin dominio propio sirve un nombre de sslip.io que apunta a la IP de la VM:
#   DOMAIN=horas.158-179-220-119.sslip.io
# Necesita los puertos 80 y 443 abiertos a internet (el reto ACME entra por ellos).
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy frontend:8080 {
		# IP real del cliente para el backend (rate limit, audit_log). Caddy descarta la que
		# mande el cliente, así que no se puede falsificar.
		header_up X-Forwarded-For {client_ip}
		header_down -Server
	}
}
