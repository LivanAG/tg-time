# HTTPS automático con Let's Encrypt. DOMAIN viene de .env.
# Sin dominio propio sirve un nombre de sslip.io, p. ej. horas.129-151-10-20.sslip.io
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy frontend:8080 {
		# IP real del cliente para el backend (rate limit, audit_log). Caddy descarta la que
		# mande el cliente, así que no se puede falsificar.
		header_up X-Forwarded-For {client_ip}
		header_down -Server
	}
}
